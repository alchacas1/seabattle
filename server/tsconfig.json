{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",

    "module": "CommonJS",
    "target": "ES2022",
    "moduleResolution": "Node",

    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    "declaration": true,
    "sourceMap": true,

    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*.ts", "src/**/*.test.ts"],
  "exclude": ["dist", "node_modules"]
}
